{
  "name": "@arcadekit/website",
  "version": "0.0.0",
  "private": true,
  "description": "The arcadekit docs site (arcadekit.dev), built from docs/ and the packages' READMEs",
  "type": "module",
  "scripts": {
    "packages": "pnpm -w run build:packages",
    "dev": "pnpm run packages && astro dev",
    "build": "pnpm run packages && astro build",
    "preview": "astro preview",
    "typecheck": "pnpm run packages && astro sync && tsc -p . && node scripts/check-snippets.mjs",
    "snippets": "node scripts/check-snippets.mjs",
    "images": "node scripts/generate-images.mjs",
    "plan": "alchemy plan",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@arcadekit/three": "workspace:*",
    "@astrojs/markdown-satteri": "^0.4.10",
    "@astrojs/starlight": "^0.43.1",
    "@effect/platform-browser": "~4.1.4",
    "@effect/platform-node": "~4.1.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "alchemy": "2.0.0-beta.87",
    "arcadekit": "workspace:*",
    "astro": "^7.4.12",
    "effect": "~4.1.4",
    "playwright": "1.63.0",
    "rolldown": "1.2.19",
    "satteri": "^0.11.7",
    "starlight-sidebar-topics": "^0.9.0",
    "three": "^0.187.0"
  }
}
