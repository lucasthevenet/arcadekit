---
// The header's mark and name: the D-pad in lime, then "arcadekit" in the text face, bold, as
// Foldkit and Effect set theirs. It replaces Starlight's SiteTitle. The mark's shape is
// public/favicon.svg's, the one text of it, drawn here inline in the accent.
import favicon from "../../public/favicon.svg?raw";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const mark = /\sd="(?<d>[^"]+)"/u.exec(favicon)?.groups?.d ?? "";
---

<a href={siteTitleHref} class="site-title">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path fill-rule="evenodd" d={mark}></path>
  </svg>
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    color: var(--ak-text);
    text-decoration: none;
    white-space: nowrap;
  }

  svg {
    flex: none;
    width: 1.625rem;
    height: 1.625rem;
    fill: var(--ak-lime);
  }

  span {
    font-family: var(--ak-font-body);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
</style>
