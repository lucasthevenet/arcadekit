---
// The page served for an address with no page (alchemy.run.ts), as Starlight's is, which
// astro.config.ts turns off: Starlight's reads a `404` entry of the docs collection when there is
// one, and the docs collection has none, since each of its entries is a page of the sidebar. Its
// text is the site's own, in content/i18n/.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
---

<StarlightPage
  frontmatter={{
    title: "404",
    template: "splash",
    editUrl: false,
    pagefind: false,
    hero: { tagline: Astro.locals.t("404.text") },
  }}
/>
