{
  "name": "@arcadekit/core",
  "version": "0.2.2",
  "description": "Renderer- and DOM-free primitives: fixed-step clock, seeded RNG, struct-of-arrays pools, spatial grid, event buffer",
  "keywords": [
    "arcadekit",
    "effect",
    "fixed-timestep",
    "game",
    "gamedev",
    "object-pool",
    "rng",
    "spatial-grid"
  ],
  "homepage": "https://github.com/lucasthevenet/arcadekit/tree/main/packages/core#readme",
  "bugs": "https://github.com/lucasthevenet/arcadekit/issues",
  "license": "MIT",
  "author": "Lucas Thevenet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/arcadekit.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "node": ">=22"
  }
}
