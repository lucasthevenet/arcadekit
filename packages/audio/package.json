{
  "name": "@arcadekit/audio",
  "version": "0.2.2",
  "description": "Play a game's sounds and music with Web Audio: unlock, voice limits, buses and crossfades",
  "keywords": [
    "arcadekit",
    "audio",
    "effect",
    "game",
    "gamedev",
    "web-audio"
  ],
  "homepage": "https://github.com/lucasthevenet/arcadekit/tree/main/packages/audio#readme",
  "bugs": "https://github.com/lucasthevenet/arcadekit/issues",
  "license": "MIT",
  "author": "Lucas Thevenet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/arcadekit.git",
    "directory": "packages/audio"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "source": "./src/browser.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p . && tsc -p tsconfig.root.json"
  },
  "devDependencies": {
    "effect": "~4.1.2"
  },
  "peerDependencies": {
    "effect": "~4.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
