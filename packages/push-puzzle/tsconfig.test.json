{
  // The tests run in Node, and a view's tests import arcadekit/render-three/testing, which
  // inflates a PNG with node:zlib: so they are checked with Node's types beside the DOM's.
  // tsconfig.json leaves them out, so Node's types reach none of the package's own code.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts"]
}
