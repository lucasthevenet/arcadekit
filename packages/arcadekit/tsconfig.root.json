{
  // What must run without a DOM (a Web Worker, a server, a test) is checked with no DOM types:
  // all of core, and the root entries of content, save, audio, runtime (GameSimulation,
  // GameLoop) and net, with net's signalling protocol (./net/signalling), which the signalling
  // worker shares. Only the ./browser entries, input, render-three and foldkit may use the DOM.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": [],
    "declaration": true,
    "isolatedDeclarations": true
  },
  "files": [
    "src/content/index.ts",
    "src/save/index.ts",
    "src/audio/index.ts",
    "src/runtime/index.ts",
    "src/net/index.ts",
    "src/net/signalling/protocol.ts"
  ],
  "include": ["src/core"]
}
