{
  // Every entry but two. tsconfig.worker.json checks arcadekit/net/worker with Cloudflare's
  // Workers types in place of the DOM's, and tsconfig.node.json checks the entries that run in
  // Node (arcadekit/render-three/testing) with Node's types beside the DOM's. So a file here
  // that imports one of those entries' public files fails: Node's built-ins have no types here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "declaration": true,
    "isolatedDeclarations": true
  },
  "include": ["src"],
  "exclude": ["src/net/worker", "src/render-three/testing"]
}
