{
  "name": "arcadekit",
  "version": "0.7.0",
  "description": "Reusable primitives for building browser games with Effect, Foldkit and Three.js",
  "keywords": [
    "arcadekit",
    "browser-games",
    "effect",
    "foldkit",
    "game",
    "gamedev",
    "three",
    "threejs"
  ],
  "homepage": "https://arcadekit.dev",
  "bugs": "https://github.com/lucasthevenet/arcadekit/issues",
  "license": "MIT",
  "author": "Lucas Thevenet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/arcadekit.git",
    "directory": "packages/arcadekit"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p . && tsc -p tsconfig.examples.json",
    "demo": "tsx examples/demo.ts",
    "duel": "tsx examples/duel.ts",
    "bench": "tsx bench/accessors.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@effect/platform-browser": "~4.1.0",
    "@types/three": "^0.187.0",
    "effect": "~4.1.2",
    "foldkit": "~0.170.0",
    "three": "^0.187.0",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^5",
    "@effect/platform-browser": "~4.1.0",
    "@types/three": "^0.187.0",
    "effect": "~4.1.2",
    "foldkit": "~0.170.0",
    "three": "^0.187.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@effect/platform-browser": {
      "optional": true
    },
    "@types/three": {
      "optional": true
    },
    "foldkit": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
