    "./Transform2d": {
      "source": "./src/Transform2d.ts",
      "types": "./dist/Transform2d.d.ts",
      "default": "./dist/Transform2d.js"
    },
    "./Transform3d": {
      "source": "./src/Transform3d.ts",
      "types": "./dist/Transform3d.d.ts",
      "default": "./dist/Transform3d.js"
    },
    "./Transport": {
      "source": "./src/Transport.ts",
      "types": "./dist/Transport.d.ts",
      "default": "./dist/Transport.js"
    },
    "./View": {
      "source": "./src/View.ts",
      "types": "./dist/View.d.ts",
      "default": "./dist/View.js"
    },
    "./ecs": {
      "source": "./src/ecs/index.ts",
      "types": "./dist/ecs.d.ts",
      "default": "./dist/ecs.js"
    }
