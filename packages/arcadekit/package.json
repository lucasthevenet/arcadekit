      "default": "./dist/Save.js"
    },
    "./Schemas": {
      "source": "./src/Schemas.ts",
      "types": "./dist/Schemas.d.ts",
      "default": "./dist/Schemas.js"
    },
    "./Services": {
      "source": "./src/Services.ts",
      "types": "./dist/Services.d.ts",
      "default": "./dist/Services.js"
    },
    "./Singleton": {
      "source": "./src/Singleton.ts",
      "types": "./dist/Singleton.d.ts",
      "default": "./dist/Singleton.js"
