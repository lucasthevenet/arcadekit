{
  "name": "arcadekit",
  "version": "0.7.0",
  "description": "Reusable primitives for building browser games with Effect, Foldkit and Three.js",
  "keywords": [
    "arcadekit",
    "browser-games",
    "effect",
    "foldkit",
    "game",
    "gamedev",
    "three",
    "threejs"
  ],
  "homepage": "https://arcadekit.dev",
  "bugs": "https://github.com/lucasthevenet/arcadekit/issues",
  "license": "MIT",
  "author": "Lucas Thevenet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/arcadekit.git",
    "directory": "packages/arcadekit"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Action": {
      "source": "./src/Action.ts",
      "types": "./dist/Action.d.ts",
      "default": "./dist/Action.js"
    },
    "./App": {
      "source": "./src/App.ts",
      "types": "./dist/App.d.ts",
      "default": "./dist/App.js"
    },
    "./App/Browser": {
      "source": "./src/App/Browser.ts",
      "types": "./dist/App/Browser.d.ts",
      "default": "./dist/App/Browser.js"
    },
    "./Assets": {
      "source": "./src/Assets.ts",
      "types": "./dist/Assets.d.ts",
      "default": "./dist/Assets.js"
    },
    "./Assets/Browser": {
      "source": "./src/Assets/Browser.ts",
      "types": "./dist/Assets/Browser.d.ts",
      "default": "./dist/Assets/Browser.js"
    },
    "./Driver": {
      "source": "./src/Driver.ts",
      "types": "./dist/Driver.d.ts",
      "default": "./dist/Driver.js"
    },
    "./Driver/Browser": {
      "source": "./src/Driver/Browser.ts",
      "types": "./dist/Driver/Browser.d.ts",
      "default": "./dist/Driver/Browser.js"
    },
    "./Event": {
      "source": "./src/Event.ts",
      "types": "./dist/Event.d.ts",
      "default": "./dist/Event.js"
    },
    "./Field": {
      "source": "./src/Field.ts",
      "types": "./dist/Field.d.ts",
      "default": "./dist/Field.js"
    },
    "./Input": {
      "source": "./src/Input.ts",
      "types": "./dist/Input.d.ts",
      "default": "./dist/Input.js"
    },
    "./Input/Browser": {
      "source": "./src/Input/Browser.ts",
      "types": "./dist/Input/Browser.d.ts",
      "default": "./dist/Input/Browser.js"
    },
    "./Migrate": {
      "source": "./src/Migrate.ts",
      "types": "./dist/Migrate.d.ts",
      "default": "./dist/Migrate.js"
    },
    "./Plugin": {
      "source": "./src/Plugin.ts",
      "types": "./dist/Plugin.d.ts",
      "default": "./dist/Plugin.js"
    },
    "./Query": {
      "source": "./src/Query.ts",
      "types": "./dist/Query.d.ts",
      "default": "./dist/Query.js"
    },
    "./Resource": {
      "source": "./src/Resource.ts",
      "types": "./dist/Resource.d.ts",
      "default": "./dist/Resource.js"
    },
    "./Save": {
      "source": "./src/Save.ts",
      "types": "./dist/Save.d.ts",
      "default": "./dist/Save.js"
    },
    "./Schemas": {
      "source": "./src/Schemas.ts",
      "types": "./dist/Schemas.d.ts",
      "default": "./dist/Schemas.js"
    },
    "./Services": {
      "source": "./src/Services.ts",
      "types": "./dist/Services.d.ts",
      "default": "./dist/Services.js"
    },
    "./Singleton": {
      "source": "./src/Singleton.ts",
      "types": "./dist/Singleton.d.ts",
      "default": "./dist/Singleton.js"
    },
    "./State": {
      "source": "./src/State.ts",
      "types": "./dist/State.d.ts",
      "default": "./dist/State.js"
    },
    "./System": {
      "source": "./src/System.ts",
      "types": "./dist/System.d.ts",
      "default": "./dist/System.js"
    },
    "./TickScheduler": {
      "source": "./src/TickScheduler.ts",
      "types": "./dist/TickScheduler.d.ts",
      "default": "./dist/TickScheduler.js"
    },
    "./ecs": {
      "source": "./src/ecs/index.ts",
      "types": "./dist/ecs.d.ts",
      "default": "./dist/ecs.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p . && tsc -p tsconfig.examples.json",
    "demo": "tsx examples/demo.ts",
    "duel": "tsx examples/duel.ts",
    "page": "vite examples/page",
    "bench": "tsx bench/accessors.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@effect/platform-browser": "~4.1.0",
    "@effect/platform-node": "~4.1.2",
    "@types/three": "^0.187.0",
    "effect": "~4.1.2",
    "foldkit": "~0.170.0",
    "three": "^0.187.0",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": "^5",
    "@effect/platform-browser": "~4.1.0",
    "@types/three": "^0.187.0",
    "effect": "~4.1.2",
    "foldkit": "~0.170.0",
    "three": "^0.187.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@effect/platform-browser": {
      "optional": true
    },
    "@types/three": {
      "optional": true
    },
    "foldkit": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
