{
  "name": "arcadekit",
  "version": "0.8.0",
  "description": "Reusable primitives for building browser games with Effect and Three.js",
  "keywords": [
    "arcadekit",
    "browser-games",
    "effect",
    "game",
    "gamedev",
    "three",
    "threejs"
  ],
  "homepage": "https://arcadekit.dev",
  "bugs": "https://github.com/lucasthevenet/arcadekit/issues",
  "license": "MIT",
  "author": "Lucas Thevenet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/arcadekit.git",
    "directory": "packages/arcadekit"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Action": {
      "source": "./src/Action.ts",
      "types": "./dist/Action.d.ts",
      "default": "./dist/Action.js"
    },
    "./App": {
      "source": "./src/App.ts",
      "types": "./dist/App.d.ts",
      "default": "./dist/App.js"
    },
    "./Assets": {
      "source": "./src/Assets.ts",
      "types": "./dist/Assets.d.ts",
      "default": "./dist/Assets.js"
    },
    "./Browser": {
      "source": "./src/Browser.ts",
      "types": "./dist/Browser.d.ts",
      "default": "./dist/Browser.js"
    },
    "./Driver": {
      "source": "./src/Driver.ts",
      "types": "./dist/Driver.d.ts",
      "default": "./dist/Driver.js"
    },
    "./Event": {
      "source": "./src/Event.ts",
      "types": "./dist/Event.d.ts",
      "default": "./dist/Event.js"
    },
    "./Field": {
      "source": "./src/Field.ts",
      "types": "./dist/Field.d.ts",
      "default": "./dist/Field.js"
    },
    "./Input": {
      "source": "./src/Input.ts",
      "types": "./dist/Input.d.ts",
      "default": "./dist/Input.js"
    },
    "./Lockstep": {
      "source": "./src/Lockstep.ts",
      "types": "./dist/Lockstep.d.ts",
      "default": "./dist/Lockstep.js"
    },
    "./Migrate": {
      "source": "./src/Migrate.ts",
      "types": "./dist/Migrate.d.ts",
      "default": "./dist/Migrate.js"
    },
    "./Plugin": {
      "source": "./src/Plugin.ts",
      "types": "./dist/Plugin.d.ts",
      "default": "./dist/Plugin.js"
    },
    "./Query": {
      "source": "./src/Query.ts",
      "types": "./dist/Query.d.ts",
      "default": "./dist/Query.js"
    },
    "./Relay": {
      "source": "./src/Relay.ts",
      "types": "./dist/Relay.d.ts",
      "default": "./dist/Relay.js"
    },
    "./Resource": {
      "source": "./src/Resource.ts",
