{
  "name": "@arcadekit/foldkit",
  "version": "0.2.1",
  "description": "Connects a @arcadekit/runtime engine to a Foldkit app",
  "keywords": [
    "arcadekit",
    "effect",
    "elm-architecture",
    "foldkit",
    "game",
    "gamedev"
  ],
  "homepage": "https://github.com/lucasthevenet/arcadekit/tree/main/packages/foldkit#readme",
  "bugs": "https://github.com/lucasthevenet/arcadekit/issues",
  "license": "MIT",
  "author": "Lucas Thevenet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/arcadekit.git",
    "directory": "packages/foldkit"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@arcadekit/runtime": "workspace:^"
  },
  "devDependencies": {
    "effect": "~4.1.2",
    "foldkit": "~0.170.0"
  },
  "peerDependencies": {
    "effect": "~4.1.2",
    "foldkit": "~0.170.0"
  },
  "engines": {
    "node": ">=22"
  }
}
