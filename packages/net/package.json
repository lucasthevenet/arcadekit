{
  "name": "@arcadekit/net",
  "version": "0.0.0",
  "description": "Play one run on several peers in delay-based lockstep, over a transport it doesn't know",
  "keywords": [
    "arcadekit",
    "effect",
    "game",
    "gamedev",
    "lockstep",
    "multiplayer",
    "webrtc"
  ],
  "homepage": "https://github.com/lucasthevenet/arcadekit/tree/main/packages/net#readme",
  "bugs": "https://github.com/lucasthevenet/arcadekit/issues",
  "license": "MIT",
  "author": "Lucas Thevenet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasthevenet/arcadekit.git",
    "directory": "packages/net"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-harness.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "source": "./src/browser/index.ts",
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./signalling": {
      "source": "./src/signalling/protocol.ts",
      "types": "./dist/signalling.d.ts",
      "default": "./dist/signalling.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p . && tsc -p tsconfig.root.json"
  },
  "dependencies": {
    "@arcadekit/core": "workspace:^",
    "@arcadekit/runtime": "workspace:^"
  },
  "devDependencies": {
    "effect": "~4.1.2"
  },
  "peerDependencies": {
    "effect": "~4.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
