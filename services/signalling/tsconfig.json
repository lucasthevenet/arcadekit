{
  // The worker runs on Cloudflare's runtime, not in a browser: Workers types, no DOM.
  // alchemy.run.ts is checked too, so a change to Alchemy's API fails the typecheck.
  // The local server runs in Node, so it has its own config (tsconfig.local.json).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "alchemy.run.ts"],
  "exclude": ["src/local.ts", "src/local.test.ts"]
}
