{
  "name": "arcadekit-workspace",
  "private": true,
  "description": "Reusable primitives for building browser games with Effect, Foldkit and Three.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @arcadekit/survivor-demo dev",
    "dev:puzzle": "pnpm --filter @arcadekit/push-puzzle-demo dev",
    "dev:docs": "pnpm --filter @arcadekit/docs dev",
    "build": "pnpm typecheck && pnpm --filter @arcadekit/survivor-demo --filter @arcadekit/push-puzzle-demo --filter @arcadekit/docs build",
    "build:packages": "pnpm --filter arcadekit run build",
    "build:docs": "pnpm --filter @arcadekit/docs build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:e2e": "vitest run --config apps/survivor-demo/vitest.e2e.config.ts",
    "test:browsers": "vitest run --config apps/survivor-demo/browser-determinism/vitest.config.ts",
    "lint:packages": "bash scripts/lint-packages.sh",
    "smoke": "node scripts/smoke-test.mjs",
    "bench": "pnpm --filter @arcadekit/bench bench",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "sounds": "node scripts/generate-placeholder-sounds.mjs",
    "sprites": "node scripts/generate-sprite-sheets.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && pnpm lint:packages && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "1.63.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
