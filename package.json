    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "@effect/platform-browser": "~4.1.0",
    "effect": "~4.1.2",
    "foldkit": "~0.170.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "private": true
}
