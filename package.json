{
  "name": "arcadekit-workspace",
  "private": true,
  "description": "Reusable primitives for building browser games with Effect and Three.js",
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && pnpm build:packages",
    "build:packages": "pnpm --filter arcadekit run build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "lint:packages": "bash scripts/lint-packages.sh",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && pnpm lint:packages && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
