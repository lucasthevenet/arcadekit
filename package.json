{
  "name": "gamekit",
  "private": true,
  "type": "module",
  "description": "Reusable primitives for building browser games with Effect, Foldkit and Three.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @gamekit/survivor-demo",
    "build": "npm run typecheck && npm run build -w @gamekit/survivor-demo",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
