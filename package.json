{
  "name": "arcadekit-workspace",
  "private": true,
  "description": "Reusable primitives for building browser games with Effect and Three.js",
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && pnpm build:packages && pnpm build:docs",
    "build:packages": "pnpm --filter './packages/*' --if-present run build",
    "build:docs": "pnpm --filter @arcadekit/website build",
    "dev:docs": "pnpm --filter @arcadekit/website dev",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tooling",
    "test": "vitest run --passWithNoTests",
    "lint:packages": "bash tooling/lint/packages.sh",
    "check": "oxfmt --check && effect-tsgo oxlint",
    "fix": "oxfmt && effect-tsgo oxlint --fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:packages && pnpm lint:packages && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@effect/tsgo": "^0.70.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "oxc-parser": "^0.159.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "publint": "^0.3.25",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
